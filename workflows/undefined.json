      "parameters": {
        "jsCode": "const app = $('Find Application URL').item.json;\nconst image = $('Extract Image').item.json;\n\nreturn {\n  json: {\n    title: app.title,\n    description: $('Edit Fields').item.json.description,\n\n    application_url: app.application_url,\n\n    source_name: 'Opportunities for Africans',\n    source_url: app.source_url,\n\n    source_image_url: image.source_image_url,\n\n    category: $('Edit Fields').item.json.category,\n\n    organization: null,\n    country: null,\n    deadline: null,\n    eligibility: null,\n    funding: null,\n    opportunity_type: null,\n\n    source_published_at: $('Edit Fields').item.json.source_published_at,\n\n    discovered_at: new Date().toISOString(),\n\n    status: 'discovered'\n  },\n\n  binary: {\n    image: $binary.image\n  }\n};"
