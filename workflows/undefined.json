      "id": "43dd3b1e-e873-4900-91c0-731e532372a1",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const html = $json.data || $json.body || '';\n\nif (!html) {\n  throw new Error('No HTML content found in HTTP Request output.');\n}\n\nconst anchorRegex = /<a\\b[^>]*href\\s*=\\s*[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi;\n\nconst links = [];\n\nlet match;\n\nwhile ((match = anchorRegex.exec(html)) !== null) {\n  const href = match[1];\n\n  const text = match[2]\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  if (!href || !text) continue;\n\n  const lowerText = text.toLowerCase();\n\n  let score = 0;\n\n  if (lowerText.includes('apply now')) score += 100;\n  if (lowerText.includes('apply here')) score += 100;\n  if (lowerText.includes('click here to apply')) score += 100;\n  if (lowerText.includes('application link')) score += 100;\n\n  if (lowerText.includes('official webpage')) score += 90;\n  if (lowerText.includes('official website')) score += 90;\n  if (lowerText.includes('visit the official')) score += 80;\n\n  if (lowerText.includes('apply')) score += 70;\n  if (lowerText.includes('application')) score += 60;\n  if (lowerText.includes('register')) score += 50;\n  if (lowerText.includes('registration')) score += 50;\n  if (lowerText.includes('learn more')) score += 30;\n  if (lowerText.includes('more information')) score += 20;\n\n  links.push({\n    text,\n    href,\n    score\n  });\n}\n\nlinks.sort((a, b) => b.score - a.score);\n\nconst bestLink = links.length > 0 && links[0].score > 0\n  ? links[0]\n  : null;\n\nreturn {\n  json: {\n    source_url: $('Edit Fields').item.json.source_url,\n    title: $('Edit Fields').item.json.title,\n\n    application_url: bestLink ? bestLink.href : null,\n    application_link_text: bestLink ? bestLink.text : null,\n\n    possible_links: links.filter(link => link.score > 0),\n\n    all_links: links\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        -336
      ],
      "id": "1763631e-0de8-4b86-9f11-1473d30cf700",
      "name": "Find Application URL"
    },
    {
      "parameters": {
        "jsCode": "const html = $('HTTP Request').item.json.data ||\n             $('HTTP Request').item.json.body ||\n             '';\n\nif (!html) {\n  throw new Error('No HTML found from OFA page.');\n}\n\n// ---------------------------------------------\n// Extract og:image\n// ---------------------------------------------\nconst ogImageMatch = html.match(\n  /<meta[^>]+property=[\"']og:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i\n);\n\nlet sourceImageUrl = ogImageMatch\n  ? ogImageMatch[1].trim()\n  : null;\n\n// ---------------------------------------------\n// Fallback: twitter:image\n// ---------------------------------------------\nif (!sourceImageUrl) {\n\n  const twitterImageMatch = html.match(\n    /<meta[^>]+property=[\"']twitter:image[\"'][^>]+content=[\"']([^\"']+)[\"']/i\n  );\n\n  if (twitterImageMatch) {\n    sourceImageUrl = twitterImageMatch[1].trim();\n  }\n}\n\n// ---------------------------------------------\n// Fallback: itemprop=image\n// ---------------------------------------------\nif (!sourceImageUrl) {\n\n  const itemPropImageMatch = html.match(\n    /<meta[^>]+itemprop=[\"']image[\"'][^>]+content=[\"']([^\"']+)[\"']/i\n  );\n\n  if (itemPropImageMatch) {\n    sourceImageUrl = itemPropImageMatch[1].trim();\n  }\n}\n\n// ---------------------------------------------\n// Return complete opportunity data\n// ---------------------------------------------\nreturn {\n  json: {\n    source_url: $('Find Application URL').item.json.source_url,\n\n    title: $('Find Application URL').item.json.title,\n\n    application_url:\n      $('Find Application URL').item.json.application_url,\n\n    application_link_text:\n      $('Find Application URL').item.json.application_link_text,\n\n    source_image_url: sourceImageUrl,\n\n    source_name: 'Opportunities for Africans',\n\n    discovered_at: new Date().toISOString(),\n\n    status: 'discovered'\n  }\n};"
      },
